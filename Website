========================================================= -->

<section id="products"
         class="section products-section">

    <div class="container">


        <div class="section-head">

            <div>

                <p class="eyebrow">
                    PRODUCT CATALOGUE
                </p>

                <h2>
                    Our Products
                </h2>

            </div>


            <p>

                Explore our bird-control and deterrent
