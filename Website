                    type="text"
                    id="name"
                    name="name"
                    placeholder="Your name"
                    required>

            </label>



            <label>

                Phone / WhatsApp

                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="Your phone number"
                    required>

            </label>



            <label>

                Product

                <select
                    id="productChoice"
                    name="product">

                    <option value="General enquiry">
                        General enquiry
                    </option>

                </select>

            </label>



            <label>

                Quantity

                <input
                    type="text"
                    id="quantity"
                    name="quantity"
                    placeholder="e.g. 100 metres / 20 pieces">

            </label>



            <label>

                Requirement

                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    placeholder="Tell us about your application or requirement..."></textarea>

            </label>



            <button
                class="btn btn-primary"
                type="submit">

                Send Enquiry via WhatsApp

            </button>


            <p class="form-note">

                Your enquiry will open WhatsApp with
                the information entered above.

            </p>

        </form>

