            </p>

        </div>



        <!-- Search / Filter -->

        <div class="catalog-tools">

            <input
                type="search"
                id="productSearch"
                placeholder="Search products..."
                aria-label="Search products">


            <select
                id="categoryFilter"
                aria-label="Filter products">

                <option value="all">
                    All Categories
                </option>

                <option value="Bird Spikes">
                    Bird Spikes
