/* =========================================================
   AYODEL INDIA PRIVATE LIMITED
   Main Website Stylesheet
   ========================================================= */


/* =========================================================
   1. GOOGLE FONTS
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap');


/* =========================================================
   2. GLOBAL VARIABLES
   ========================================================= */

:root {

    --ink: #10231d;

    --dark: #0d211a;

    --accent: #176b4b;

    --accent-dark: #0f5439;

    --accent-light: #dff2e8;

    --paper: #f7faf8;

    --white: #ffffff;

    --muted: #64736d;

    --line: #dfe8e3;

    --shadow:
        0 15px 35px rgba(13, 33, 26, 0.08);

    --shadow-large:
        0 25px 60px rgba(13, 33, 26, 0.15);

    --radius: 16px;

    --transition: all 0.25s ease;

}


/* =========================================================
   3. RESET
   ========================================================= */

* {

    margin: 0;
    padding: 0;
    box-sizing: border-box;

}


html {

    scroll-behavior: smooth;

}


body {

    font-family:
        "DM Sans",
        Arial,
        sans-serif;

    color: var(--ink);

    background: var(--paper);

    line-height: 1.6;

    overflow-x: hidden;

}


img {

    max-width: 100%;

    display: block;

}


a {

    text-decoration: none;

    color: inherit;

}


button,
input,
textarea,
select {

    font-family: inherit;

}


button {

    cursor: pointer;

}


.container {

    width: min(1160px, 92%);

    margin: 0 auto;

}


/* =========================================================
   4. TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4 {

    font-family:
        "Manrope",
        Arial,
        sans-serif;

    color: var(--ink);

}


h1 {

    font-size:
        clamp(44px, 6vw, 76px);

    line-height: 1.08;

    letter-spacing: -0.04em;

}


h2 {

    font-size:
        clamp(34px, 4vw, 52px);

    line-height: 1.1;

    letter-spacing: -0.035em;

}


h3 {

    font-size: 20px;

    line-height: 1.25;

}


p {

    color: var(--muted);

}


/* =========================================================
   5. EYEBROW TEXT
   ========================================================= */

.eyebrow {

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 0.18em;

    color: var(--accent);

    margin-bottom: 12px;

    text-transform: uppercase;

}


/* =========================================================
   6. HEADER
   ========================================================= */

.site-header {

    position: sticky;

    top: 0;

    z-index: 1000;

    background:
        rgba(247, 250, 248, 0.94);

    backdrop-filter:
        blur(14px);

    border-bottom:
        1px solid var(--line);

}


.nav-wrap {

    min-height: 76px;

    display: flex;

    align-items: center;

    gap: 28px;

}


/* =========================================================
   7. BRAND / LOGO
   ========================================================= */

.brand {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-right: auto;

}


.brand-mark {

    width: 42px;

    height: 42px;

    display: grid;

    place-items: center;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            var(--accent),
            #0e4f37
        );

    color: var(--white);

    font-family: "Manrope";

    font-size: 20px;

    font-weight: 800;

    box-shadow:
        0 7px 18px
        rgba(23, 107, 75, 0.2);

}


.brand-text strong {

    display: block;

    font-family: "Manrope";

    font-size: 17px;

    line-height: 1;

    letter-spacing: 0.13em;

}


.brand-text small {

    display: block;

    margin-top: 5px;

    color: var(--muted);

    font-size: 8px;

    line-height: 1;

    letter-spacing: 0.13em;

}


/* =========================================================
   8. NAVIGATION
   ========================================================= */

.nav {

    display: flex;

    align-items: center;

    gap: 22px;

}


.nav a {

    position: relative;

    font-size: 14px;

    font-weight: 600;

    color: #30443d;

    transition: var(--transition);

}


.nav a::after {

    content: "";

    position: absolute;

    left: 0;

    bottom: -7px;

    width: 0;

    height: 2px;

    background: var(--accent);

    transition: var(--transition);

}


.nav a:hover {

    color: var(--accent);

}


.nav a:hover::after {

    width: 100%;

}


/* =========================================================
   9. BUTTONS
   ========================================================= */

.btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding:
        11px 19px;

    border-radius: 10px;

    border: 1px solid transparent;

    font-size: 14px;

    font-weight: 700;

    transition: var(--transition);

}


.btn-primary {

    color: var(--white);

    background: var(--accent);

}


.btn-primary:hover {

    background: var(--accent-dark);

    transform:
        translateY(-2px);

    box-shadow:
        0 9px 24px
        rgba(23, 107, 75, 0.25);

}


.btn-light {

    color: var(--ink);

    background: var(--white);

    border-color: var(--line);

}


.btn-light:hover {

    border-color: var(--accent);

    color: var(--accent);

    transform:
        translateY(-2px);

}


/* =========================================================
   10. MOBILE MENU
   ========================================================= */

.menu-toggle {

    display: none;

    border: 0;

    background: transparent;

    color: var(--ink);

    font-size: 25px;

    line-height: 1;

}


/* =========================================================
   11. HERO
   ========================================================= */

.hero {

    position: relative;

    padding:
        92px 0 75px;

    background:
        linear-gradient(
            135deg,
            #edf7f1 0%,
            #f8fbf9 60%,
            #ffffff 100%
        );

    overflow: hidden;

}


.hero::before {

    content: "";

    position: absolute;

    width: 450px;

    height: 450px;

    border-radius: 50%;

    right: -180px;

    top: -220px;

    background:
        rgba(23, 107, 75, 0.06);

}


.hero-grid {

    display: grid;

    grid-template-columns:
        1.05fr 0.95fr;

    gap: 65px;

    align-items: center;

}


.hero-copy {

    position: relative;

    z-index: 2;

}


.hero h1 {

    margin-bottom: 23px;

}


.hero h1 span {

    color: var(--accent);

}


.hero-text {

    max-width: 610px;

    font-size: 18px;

    line-height: 1.7;

}


.hero-actions {

    display: flex;

    gap: 12px;

    margin:
        30px 0 38px;

}


/* =========================================================
   12. HERO TRUST ROW
   ========================================================= */

.trust-row {

    display: flex;

    gap: 30px;

    padding-top: 20px;

    border-top:
        1px solid var(--line);

}


.trust-row div {

    display: grid;

    gap: 2px;

}


.trust-row strong {

    font-size: 13px;

}


.trust-row span {

    color: var(--muted);

    font-size: 12px;

}


/* =========================================================
   13. HERO VISUAL
   ========================================================= */

.hero-visual {

    min-height: 430px;

    display: grid;

    place-items: center;

}


.visual-card {

    position: relative;

    width: min(440px, 100%);

    height: 430px;

    overflow: hidden;

    border-radius: 28px;

    background:
        linear-gradient(
            150deg,
            #1b7252,
            #0b2e22
        );

    box-shadow: var(--shadow-large);

}


.visual-card::before {

    content: "";

    position: absolute;

    width: 380px;

    height: 380px;

    right: -120px;

    top: -100px;

    border:
        1px solid
        rgba(255, 255, 255, 0.15);

    border-radius: 50%;

}


.visual-card::after {

    content: "";

    position: absolute;

    width: 280px;

    height: 280px;

    left: -100px;

    bottom: -120px;

    border:
        1px solid
        rgba(255, 255, 255, 0.12);

    border-radius: 50%;

}


.bird {

    position: absolute;

    top: 85px;

    right: 75px;

    color: rgba(255, 255, 255, 0.95);

    font-size: 78px;

    transform:
        rotate(45deg);

}


.spike-line {

    position: absolute;

    left: 38px;

    right: 38px;

    bottom: 116px;

    height: 48px;

    border-bottom:
        7px solid
        rgba(255, 255, 255, 0.9);

    background:
        repeating-linear-gradient(
            90deg,
            transparent 0 22px,
            rgba(255, 255, 255, 0.9) 23px 27px,
            transparent 28px 48px
        );

}


.visual-label {

    position: absolute;

    left: 40px;

    bottom: 32px;

    display: grid;

    color: var(--white);

}


.visual-label strong {

    font-size: 18px;

}


.visual-label span {

    margin-top: 3px;

    color:
        rgba(255, 255, 255, 0.72);

    font-size: 12px;

}


/* =========================================================
   14. QUICK CATEGORY STRIP
   ========================================================= */

.quick-strip {

    background: var(--dark);

    color: var(--white);

}


.quick-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    padding:
        27px 0;

}


.quick-grid > div {

    padding:
        5px 25px;

    border-right:
        1px solid
        rgba(255, 255, 255, 0.14);

}


.quick-grid > div:last-child {

    border-right: 0;

}


.quick-grid span {

    display: block;

    margin-bottom: 3px;

    color: #9ac9b2;

    font-size: 11px;

    font-weight: 700;

}


.quick-grid strong {

    display: block;

    color: var(--white);

    font-size: 15px;

}


.quick-grid p {

    margin-top: 2px;

    color: #afbeb8;

    font-size: 12px;

}


/* =========================================================
   15. GENERAL SECTIONS
   ========================================================= */

.section {

    padding:
        90px 0;

}


.two-col {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 80px;

}


.about-copy {

    font-size: 17px;

}


.about-copy p {

    margin-bottom: 20px;

}


.text-link {

    display: inline-block;

    margin-top: 5px;

    color: var(--accent);

    font-weight: 800;

}


.text-link:hover {

    text-decoration: underline;

}


/* =========================================================
   16. PRODUCT SECTION
   ========================================================= */

.products-section {

    background: var(--white);

}


.section-head {

    display: flex;

    justify-content: space-between;

    align-items: flex-end;

    gap: 30px;

    margin-bottom: 28px;

}


.section-head > p {

    max-width: 360px;

    margin: 0;

    font-size: 14px;

}


/* =========================================================
   17. PRODUCT SEARCH
   ========================================================= */

.catalog-tools {

    display: flex;

    gap: 12px;

    margin-bottom: 28px;

}


.catalog-tools input,
.catalog-tools select {

    width: 100%;

    padding:
        13px 15px;

    border:
        1px solid
        var(--line);

    border-radius: 10px;

    background: var(--white);

    color: var(--ink);

    outline: none;

    font-size: 14px;

    transition: var(--transition);

}


.catalog-tools input {

    max-width: 600px;

}


.catalog-tools select {

    max-width: 240px;

}


.catalog-tools input:focus,
.catalog-tools select:focus {

    border-color: var(--accent);

    box-shadow:
        0 0 0 3px
        rgba(23, 107, 75, 0.08);

}


/* =========================================================
   18. PRODUCT GRID
========================================================= */

.product-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

}


.product-card {

    overflow: hidden;

    background: var(--white);

    border:
        1px solid
        var(--line);

    border-radius: var(--radius);

    transition: var(--transition);

}


.product-card:hover {

    transform:
        translateY(-5px);

    box-shadow: var(--shadow);

}


/* =========================================================
   19. PRODUCT IMAGE
========================================================= */

.product-image {

    position: relative;

    height: 190px;

    display: grid;

    place-items: center;

    text-align: center;

    padding: 20px;

    background:
        linear-gradient(
            145deg,
            #edf6f1,
            #dcece3
        );

    color: var(--accent);

    font-family: "Manrope";

    font-size: 25px;

    font-weight: 800;

    letter-spacing: 0.08em;

}


.product-image::after {

    content: "PRODUCT IMAGE";

    position: absolute;

    bottom: 12px;

    left: 0;

    right: 0;

    color:
        rgba(23, 107, 75, 0.45);

    font-family:
        "DM Sans",
        Arial,
        sans-serif;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 0.15em;

}


.product-image small {

    font-family:
        "DM Sans",
        Arial,
        sans-serif;

    font-size: 11px;

    letter-spacing: 0.03em;

}


/* =========================================================
   20. PRODUCT CONTENT
========================================================= */

.product-content {

    padding: 18px;

}


.product-content .tag {

    display: inline-block;

    color: var(--accent);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 0.1em;

    text-transform: uppercase;

}


.product-content h3 {

    margin:
        7px 0 8px;

    font-size: 18px;

}


.product-content p {

    min-height: 62px;

    margin-bottom: 15px;

    font-size: 13px;

    line-height: 1.6;

}


.product-actions {

    display: flex;

    gap: 8px;

}


.small-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 38px;

    padding:
        8px 11px;

    border-radius: 8px;

    background: var(--accent-light);

    color: var(--accent);

    border: 0;

    font-size: 12px;

    font-weight: 800;

    transition: var(--transition);

}


.small-btn:hover {

    background: var(--accent);

    color: var(--white);

}


.no-products {

    padding: 35px 0;

    text-align: center;

    color: var(--muted);

}


/* =========================================================
   21. APPLICATION SECTION
========================================================= */

.applications {

    background:
        #edf5f0;

}


.application-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 16px;

    margin-top: 32px;

}


.application-grid article {

    padding: 25px;

    background: var(--white);

    border:
        1px solid
        var(--line);

    border-radius: var(--radius);

    transition: var(--transition);

}


.application-grid article:hover {

    transform:
        translateY(-4px);

    box-shadow: var(--shadow);

}


.application-icon {

    display: inline-block;

    color: var(--accent);

    font-size: 30px;

    line-height: 1;

}


.application-grid h3 {

    margin:
        15px 0 6px;

}


.application-grid p {

    font-size: 13px;

}


/* =========================================================
   22. GALLERY
========================================================= */

.gallery {

    background: var(--white);

}


.gallery-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;

    margin-top: 32px;

}


.gallery-item {

    position: relative;

    overflow: hidden;

    min-height: 250px;

    border-radius: 18px;

    background:
        #f0f6f2;

}


.gallery-item img {

    width: 100%;

    height: 280px;

    object-fit: cover;

}


.gallery-placeholder {

    min-height: 250px;

    height: 100%;

    display: grid;

    place-items: center;

    align-content: center;

    gap: 7px;

    text-align: center;

    border:
        1px dashed
        #b9c9c1;

    color: var(--accent);

}


.gallery-placeholder small {

    color: var(--muted);

    font-family:
        "DM Sans",
        Arial,
        sans-serif;

    font-weight: 400;

}


/* =========================================================
   23. QUOTE BANNER
========================================================= */

.quote-banner {

    padding:
        65px 0;

    background:
        var(--accent-light);

}


.quote-wrap {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 40px;

}


.quote-wrap h2 {

    margin-bottom: 12px;

    font-size:
        clamp(32px, 4vw, 44px);

}


.quote-wrap p {

    max-width: 650px;

}


/* =========================================================
   24. FAQ
========================================================= */

.faq {

    background: var(--paper);

}


.faq-list {

    margin-top: 30px;

    border-top:
        1px solid
        var(--line);

}


details {

    border-bottom:
        1px solid
        var(--line);

}


summary {

    padding:
        19px 0;

    cursor: pointer;

    list-style: none;

    font-weight: 700;

}


summary::-webkit-details-marker {

    display: none;

}


summary::after {

    content: "+";

    float: right;

    color: var(--accent);

    font-size: 20px;

}


details[open] summary::after {

    content: "−";

}


details p {

    max-width: 800px;

    padding:
        0 35px 20px 0;

    font-size: 14px;

}


/* =========================================================
   25. CONTACT
========================================================= */

.contact {

    background: var(--white);

}


.contact-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 80px;

}


.contact-grid > div > p:not(.eyebrow) {

    max-width: 520px;

    margin-top: 18px;

}


/* =========================================================
   26. CONTACT CARDS
========================================================= */

.contact-cards {

    display: grid;

    gap: 12px;

    margin-top: 30px;

}


.contact-cards div {

    display: grid;

    gap: 2px;

    padding:
        15px 18px;

    background: var(--paper);

    border-radius: 10px;

    border:
        1px solid
        var(--line);

}


.contact-cards strong {

    font-size: 13px;

}


.contact-cards span {

    color: var(--muted);

    font-size: 13px;

}


/* =========================================================
   27. QUOTE FORM
========================================================= */

.quote-form {

    display: grid;

    gap: 14px;

    padding: 28px;

    background: var(--paper);

    border:
        1px solid
        var(--line);

    border-radius: 18px;

}


.quote-form label {

    display: block;

    color: var(--ink);

    font-size: 13px;

    font-weight: 700;

}


.quote-form input,
.quote-form select,
.quote-form textarea {

    display: block;

    width: 100%;

    margin-top: 6px;

    padding:
        13px 14px;

    background: var(--white);

    border:
        1px solid
        var(--line);

    border-radius: 9px;

    color: var(--ink);

    font-size: 14px;

    outline: none;

    resize: vertical;

    transition: var(--transition);

}


.quote-form input:focus,
.quote-form select:focus,
.quote-form textarea:focus {

    border-color: var(--accent);

    box-shadow:
        0 0 0 3px
        rgba(23, 107, 75, 0.08);

}


.form-note {

    margin: 0;

    font-size: 11px;

}


/* =========================================================
   28. FOOTER
========================================================= */

footer {

    padding:
        55px 0 20px;

    background: var(--dark);

    color: var(--white);

}


.footer-grid {

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 50px;

}


.footer-grid > div {

    display: grid;

    align-content: start;

    gap: 7px;

}


.footer-grid strong {

    color: var(--white);

    font-size: 14px;

}


.footer-grid p,
.footer-grid span,
.footer-grid a {

    color: #aebdb6;

    font-size: 13px;

}


.footer-grid a:hover {

    color: var(--white);

}


.footer-brand {

    margin-bottom: 8px;

}


.copyright {

    margin-top: 35px;

    padding-top: 18px;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.13);

    color: #82948c;

    font-size: 11px;

}


/* =========================================================
   29. TABLET
========================================================= */

@media (max-width: 1000px) {

    .nav {

        gap: 14px;

    }


    .nav a {

        font-size: 13px;

    }


    .hero-grid {

        gap: 35px;

    }


    .product-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }


    .application-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

}


/* =========================================================
   30. MOBILE NAVIGATION
========================================================= */

@media (max-width: 900px) {

    .nav-cta {

        display: none;

    }


    .menu-toggle {

        display: block;

    }


    .nav {

        display: none;

    }


    .nav-wrap.menu-open .nav {

        position: absolute;

        top: 76px;

        left: 0;

        right: 0;

        display: flex;

        flex-direction: column;

        align-items: stretch;

        gap: 0;

        padding:
            10px 4% 18px;

        background: var(--white);

        border-bottom:
            1px solid
            var(--line);

        box-shadow:
            0 15px 30px
            rgba(0, 0, 0, 0.08);

    }


    .nav-wrap.menu-open .nav a {

        padding: 12px 0;

        border-bottom:
            1px solid
            var(--line);

    }


    .nav-wrap.menu-open .nav a:last-child {

        border-bottom: 0;

    }


    .nav a::after {

        display: none;

    }


    .hero-grid {

        grid-template-columns: 1fr;

    }


    .hero-visual {

        min-height: 360px;

    }


    .two-col {

        grid-template-columns: 1fr;

        gap: 35px;

    }


    .contact-grid {

        grid-template-columns: 1fr;

        gap: 45px;

    }


    .footer-grid {

        grid-template-columns:
            1fr 1fr;

    }

}


/* =========================================================
   31. SMALL MOBILE
========================================================= */

@media (max-width: 600px) {

    .container {

        width: min(92%, 500px);

    }


    .nav-wrap {

        min-height: 70px;

    }


    .brand-mark {

        width: 38px;

        height: 38px;

    }


    .brand-text strong {

        font-size: 15px;

    }


    .brand-text small {

        font-size: 7px;

    }


    .hero {

        padding:
            65px 0;

    }


    .hero h1 {

